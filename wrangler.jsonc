{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1try",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "LEADERBOARD_KV",
      "id": "d793e762a8bc446eb52a973c3feb780a"
    }
  ]
}
